# Fragment appliqué sur imx_v6_v7_defconfig pour produire config-gigaset-maxwell10.armv7
# (voir pmos/README.md). Régénérer la config complète après modification.

# --- Démarrage par `go` : DTB appendé, initrd par ATAGs (tools/goshim) ---
CONFIG_ARM_APPENDED_DTB=y
CONFIG_ARM_ATAG_DTB_COMPAT=y
CONFIG_ARM_ATAG_DTB_COMPAT_CMDLINE_FROM_BOOTLOADER=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_RD_LZ4=y
CONFIG_RD_XZ=y
CONFIG_RD_ZSTD=y
CONFIG_LOCALVERSION="-gigaset-maxwell10"
# CONFIG_LOCALVERSION_AUTO is not set

# --- Exigences postmarketOS (pmbootstrap kconfig check) ---
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y
CONFIG_CGROUPS=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_CGROUP_BPF=y
CONFIG_MEMCG=y
CONFIG_NAMESPACES=y
CONFIG_USER_NS=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_INPUT_EVDEV=y
# buffyboard (clavier virtuel) crée son clavier par uinput
CONFIG_INPUT_MISC=y
CONFIG_INPUT_UINPUT=y
CONFIG_UEVENT_HELPER=n
CONFIG_MD=y
CONFIG_DM_CRYPT=y
CONFIG_BLK_DEV_DM=y
CONFIG_CRYPTO_XTS=y
CONFIG_CRYPTO_USER_API_HASH=y
CONFIG_CRYPTO_USER_API_SKCIPHER=y
CONFIG_ZRAM=m
# zram-swap de pmOS demande zstd (6.12 : un backend par algorithme)
CONFIG_ZRAM_BACKEND_ZSTD=y
CONFIG_ZRAM_BACKEND_LZ4=y
CONFIG_ZRAM_DEF_COMP_ZSTD=y

CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_VFAT_FS=y
CONFIG_FAT_DEFAULT_IOCHARSET="iso8859-1"
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_BINFMT_MISC=m
CONFIG_FHANDLE=y
CONFIG_INOTIFY_USER=y
CONFIG_SECCOMP=y
CONFIG_BPF_SYSCALL=y
CONFIG_NETFILTER=y
CONFIG_NF_TABLES=m
CONFIG_NF_TABLES_INET=y
CONFIG_NFT_CT=m
CONFIG_NFT_NAT=m
CONFIG_NFT_MASQ=m
CONFIG_NFT_REJECT=m
CONFIG_NF_CONNTRACK=m
CONFIG_NF_NAT=m
CONFIG_IP_NF_IPTABLES=m
CONFIG_WIREGUARD=m
CONFIG_TUN=m
CONFIG_VETH=m
CONFIG_BRIDGE=y

# --- systemd (canal systemd-edge, utilisé par Phosh/GNOME/Plasma) ---
CONFIG_PSI=y
CONFIG_CGROUP_SCHED=y
CONFIG_FAIR_GROUP_SCHED=y
CONFIG_CPUSETS=y
CONFIG_BLK_CGROUP=y
CONFIG_AUTOFS_FS=y
CONFIG_TMPFS_XATTR=y
CONFIG_SECCOMP_FILTER=y

# --- Réseau USB (gadget configfs, mini-USB caché) ---
CONFIG_USB_GADGET=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_SERIAL=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_CONFIGFS_RNDIS=y
CONFIG_USB_CONFIGFS_ECM=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_USB_CHIPIDEA=y
CONFIG_USB_CHIPIDEA_UDC=y
CONFIG_USB_CHIPIDEA_HOST=y
# les anciens gadgets legacy prennent l'UDC avant configfs
# CONFIG_USB_ZERO is not set
# CONFIG_USB_ETH is not set
# CONFIG_USB_MASS_STORAGE is not set
# CONFIG_USB_G_SERIAL is not set
CONFIG_USB_HUB_USB251XB=y
CONFIG_USB_HID=y

# --- Firmwares : Alpine/pmOS les livrent compressés en .zst ---
CONFIG_FW_LOADER_COMPRESS=y
CONFIG_FW_LOADER_COMPRESS_ZSTD=y
CONFIG_FW_LOADER_COMPRESS_XZ=y

# --- Matériel Maxwell 10 ---
CONFIG_MMC_SDHCI_ESDHC_IMX=y
CONFIG_PWRSEQ_SIMPLE=y
CONFIG_DRM=y
CONFIG_DRM_IMX=y
CONFIG_DRM_IMX_LDB=y
CONFIG_DRM_PANEL_LVDS=y
CONFIG_DRM_ETNAVIV=m
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_IMX_IPUV3_CORE=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_BACKLIGHT_PWM=y
CONFIG_PWM_IMX27=y
CONFIG_TOUCHSCREEN_EDT_FT5X06=y
CONFIG_KEYBOARD_GPIO=y
CONFIG_FEC=y
CONFIG_NET_DSA=y
CONFIG_NET_DSA_MV88E6XXX=y
CONFIG_NET_DSA_TAG_DSA=y
CONFIG_NET_DSA_TAG_EDSA=y
CONFIG_FIXED_PHY=y
CONFIG_MARVELL_PHY=y
CONFIG_WLAN=y
CONFIG_ATH6KL=m
CONFIG_ATH6KL_SDIO=m
CONFIG_CFG80211=m
CONFIG_MAC80211=m
CONFIG_SPI_IMX=y
CONFIG_MTD=y
CONFIG_MTD_SPI_NOR=y
CONFIG_IMX2_WDT=y
CONFIG_IMX_THERMAL=y
CONFIG_SENSORS_ISL29018=m
CONFIG_GPIO_SYSFS=n

# --- Inutile ici, et exige python3 au build (en-têtes générés en 6.12) ---
# CONFIG_DRM_MSM is not set

# --- Réactivité de l'interface ---
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y
CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y
CONFIG_HZ_250=y
CONFIG_PREEMPT=y
CONFIG_IOSCHED_BFQ=y

# --- Bluetooth AR3002 (UART5) et rfkill, pour la suite ---
CONFIG_BT_HCIUART_ATH3K=y
CONFIG_RFKILL_GPIO=y
