# Reference: <https://postmarketos.org/vendorkernel>
# Noyau mainline pour le Gigaset Maxwell 10 (i.MX6Q).
# Démarrage : U-Boot vendeur (HAB fermé) → `go` sur /boot/go.bin
# (goshim + zImage + DTB appendé), initramfs passé par ATAGs. Voir docs/postmarketos.md.
pkgname=linux-gigaset-maxwell10
pkgver=6.12
pkgrel=4
pkgdesc="Gigaset Maxwell 10 mainline kernel"
arch="armv7"
_carch="arm"
_flavor="gigaset-maxwell10"
url="https://kernel.org"
license="GPL-2.0-only"
options="!strip !check !tracedeps pmb:cross-native pmb:kconfigcheck-community"
makedepends="
	bash
	bc
	bison
	devicepkg-dev
	findutils
	flex
	gmp-dev
	installkernel
	linux-headers
	mpc1-dev
	mpfr-dev
	openssl-dev
	perl
	python3
	postmarketos-installkernel
	xz
	"

_config="config-$_flavor.$arch"
_dtb="imx6q-gigaset-maxwell10"
source="
	https://cdn.kernel.org/pub/linux/kernel/v${pkgver%%.*}.x/linux-$pkgver.tar.xz
	$_config
	$_dtb.dts
	goshim.S
	0001-net-dsa-mv88e6xxx-pulse-reset-before-detection.patch
	"
builddir="$srcdir/linux-$pkgver"

prepare() {
	default_prepare
	cp "$srcdir/$_dtb.dts" arch/arm/boot/dts/nxp/imx/
	echo "dtb-\$(CONFIG_SOC_IMX6Q) += $_dtb.dtb" >> arch/arm/boot/dts/nxp/imx/Makefile
	cp "$srcdir/$_config" .config
}

build() {
	unset LDFLAGS
	make ARCH="$_carch" CC="${CC:-gcc}" \
		KBUILD_BUILD_VERSION="$((pkgrel + 1))-postmarketOS" \
		zImage modules dtbs

	# Cale goshim (1 Kio, position-indépendante) placée devant le zImage
	# Assemblage par le compilateur, mais édition de liens directe par ld :
	# le gcc d'Alpine produit du PIE par défaut (.gnu.hash qui chevauche .text à 0).
	"${CC:-gcc}" -c -o goshim.o "$srcdir/goshim.S"
	"${CROSS_COMPILE}ld" -Ttext=0 -e _start --build-id=none -o goshim.elf goshim.o
	"${CROSS_COMPILE}objcopy" -O binary -j .text goshim.elf goshim.bin
	[ "$(wc -c < goshim.bin)" -eq 1024 ] || die "goshim.bin ne fait pas 1024 octets"
}

package() {
	mkdir -p "$pkgdir/boot"
	make zinstall modules_install dtbs_install \
		ARCH="$_carch" \
		INSTALL_PATH="$pkgdir/boot" \
		INSTALL_MOD_PATH="$pkgdir" \
		INSTALL_MOD_STRIP=1 \
		INSTALL_DTBS_PATH="$pkgdir/boot/dtbs"
	rm -f "$pkgdir"/lib/modules/*/build "$pkgdir"/lib/modules/*/source

	# Fichier chargé par U-Boot : fatload mmc 1:1 0x12000000 go.bin
	cat goshim.bin arch/arm/boot/zImage \
		"arch/arm/boot/dts/nxp/imx/$_dtb.dtb" > "$pkgdir/boot/go.bin"

	install -D "$builddir/include/config/kernel.release" \
		"$pkgdir/usr/share/kernel/$_flavor/kernel.release"
}

# Sommes générées par : pmbootstrap checksum linux-gigaset-maxwell10
# (pmos/sync.sh recopie le DT et goshim.S depuis le dépôt avant)
sha512sums=""
