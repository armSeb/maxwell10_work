+struct ov9740_mode {
+	u32 width, height;
+	const struct ov9740_reg *regs;
+	unsigned int n;
+};
+
+static const struct ov9740_mode ov9740_modes[] = {
+	{ 1280, 720, ov9740_720p, ARRAY_SIZE(ov9740_720p) },
+	{ 640, 480, ov9740_vga, ARRAY_SIZE(ov9740_vga) },
+};
+
+
+static const char * const ov9740_supply_names[] = { "DOVDD", "AVDD", "DVDD" };
+
+struct ov9740 {
+	struct i2c_client *client;
+	struct v4l2_subdev sd;
+	struct media_pad pad;
+	struct v4l2_ctrl_handler ctrls;
+	struct v4l2_ctrl *hflip, *vflip;
+	struct clk *xclk;
+	struct gpio_desc *pwdn, *reset;
+	struct regulator_bulk_data supplies[ARRAY_SIZE(ov9740_supply_names)];
+	struct mutex lock;		/* format, power and streaming state */
+	struct v4l2_mbus_framefmt fmt;	/* active format */
+	s64 link_freq;
+	bool powered;
+};
+
+static inline struct ov9740 *to_ov9740(struct v4l2_subdev *sd)
+{
+	return container_of(sd, struct ov9740, sd);
+}
+
+static int ov9740_read(struct ov9740 *s, u16 reg, u8 *val)
+{
+	u8 buf[2] = { reg >> 8, reg & 0xff };
+	struct i2c_msg msg[] = {
+		{ .addr = s->client->addr, .flags = 0, .len = 2, .buf = buf },
+		{ .addr = s->client->addr, .flags = I2C_M_RD, .len = 1, .buf = val },
+	};
+	int ret = i2c_transfer(s->client->adapter, msg, 2);
+
+	if (ret != 2) {
+		dev_err(&s->client->dev, "read 0x%04x failed (%d)\n", reg, ret);
+		return ret < 0 ? ret : -EIO;
+	}
+	return 0;
+}
+
+static int ov9740_write(struct ov9740 *s, u16 reg, u8 val)
+{
+	u8 buf[3] = { reg >> 8, reg & 0xff, val };
+	int ret = i2c_master_send(s->client, buf, 3);
+
+	if (ret != 3) {
+		dev_err(&s->client->dev, "write 0x%04x failed (%d)\n", reg, ret);
+		return ret < 0 ? ret : -EIO;
+	}
+	return 0;
+}
+
+static int ov9740_write_array(struct ov9740 *s, const struct ov9740_reg *r, int n)
+{
+	for (int i = 0; i < n; i++) {
+		int ret = ov9740_write(s, r[i].reg, r[i].val);
+
+		if (ret)
+			return ret;
+		if (r[i].reg == OV9740_SOFTWARE_RESET)
+			usleep_range(1000, 2000);
+	}
+	return 0;
+}
+
+
+static int ov9740_power_on(struct ov9740 *s)
+{
+	int ret;
+
+	if (s->powered)
+		return 0;
+	ret = regulator_bulk_enable(ARRAY_SIZE(s->supplies), s->supplies);
+	if (ret)
+		return ret;
+	ret = clk_prepare_enable(s->xclk);
+	if (ret) {
+		regulator_bulk_disable(ARRAY_SIZE(s->supplies), s->supplies);
+		return ret;
+	}
+	gpiod_set_value_cansleep(s->reset, 1);
+	gpiod_set_value_cansleep(s->pwdn, 0);
+	usleep_range(1000, 2000);
+	gpiod_set_value_cansleep(s->reset, 0);
+	msleep(20);
+	s->powered = true;
+	return 0;
+}
+
+static void ov9740_power_off(struct ov9740 *s)
+{
+	if (!s->powered)
+		return;
+	gpiod_set_value_cansleep(s->pwdn, 1);
+	gpiod_set_value_cansleep(s->reset, 1);
+	clk_disable_unprepare(s->xclk);
+	regulator_bulk_disable(ARRAY_SIZE(s->supplies), s->supplies);
+	s->powered = false;
+}
+
+static const struct ov9740_mode *ov9740_find_mode(u32 w, u32 h)
+{
+	return v4l2_find_nearest_size(ov9740_modes, ARRAY_SIZE(ov9740_modes),
+				      width, height, w, h);
+}
+
+/* full register setup, sensor left in standby (lanes in LP-11) */
+static int ov9740_setup(struct ov9740 *s)
+{
+	u8 ort = (s->vflip->val ? 0x2 : 0) | (s->hflip->val ? 0x1 : 0);
+	int ret;
+
+	const struct ov9740_mode *m = ov9740_find_mode(s->fmt.width, s->fmt.height);
+
+	ret = ov9740_write_array(s, m->regs, m->n);
+	if (!ret)
+		ret = ov9740_write(s, OV9740_IMAGE_ORT, ort);
+	return ret;
+}
+
+
+static void ov9740_fill_fmt(struct v4l2_mbus_framefmt *f, u32 w, u32 h)
+{
+	const struct ov9740_mode *m = ov9740_find_mode(w, h);
+
+	memset(f, 0, sizeof(*f));
+	f->width = m->width;
+	f->height = m->height;
+	f->code = MEDIA_BUS_FMT_UYVY8_2X8;
+	f->field = V4L2_FIELD_NONE;
+	f->colorspace = V4L2_COLORSPACE_SRGB;
+	f->ycbcr_enc = V4L2_YCBCR_ENC_601;
+	f->quantization = V4L2_QUANTIZATION_FULL_RANGE;
+	f->xfer_func = V4L2_XFER_FUNC_SRGB;
+}
+
+/* ---- subdev ops ---------------------------------------------------------- */
+
+static int ov9740_enum_mbus_code(struct v4l2_subdev *sd, struct v4l2_subdev_state *st,
+				 struct v4l2_subdev_mbus_code_enum *code)
+{
+	if (code->pad || code->index)
+		return -EINVAL;
+	code->code = MEDIA_BUS_FMT_UYVY8_2X8;
+	return 0;
+}
+
+static int ov9740_enum_frame_size(struct v4l2_subdev *sd, struct v4l2_subdev_state *st,
+				  struct v4l2_subdev_frame_size_enum *fse)
+{
+	if (fse->pad || fse->index >= ARRAY_SIZE(ov9740_modes) ||
+	    fse->code != MEDIA_BUS_FMT_UYVY8_2X8)
+		return -EINVAL;
+	fse->min_width = fse->max_width = ov9740_modes[fse->index].width;
+	fse->min_height = fse->max_height = ov9740_modes[fse->index].height;
+	return 0;
+}
+
+static int ov9740_get_fmt(struct v4l2_subdev *sd, struct v4l2_subdev_state *st,
+			  struct v4l2_subdev_format *fmt)
+{
+	struct ov9740 *s = to_ov9740(sd);
+
+	if (fmt->pad)
+		return -EINVAL;
+	if (fmt->which == V4L2_SUBDEV_FORMAT_TRY) {
+		fmt->format = *v4l2_subdev_state_get_format(st, 0);
+		return 0;
+	}
+	mutex_lock(&s->lock);
+	fmt->format = s->fmt;
+	mutex_unlock(&s->lock);
+	return 0;
+}
+
+static int ov9740_set_fmt(struct v4l2_subdev *sd, struct v4l2_subdev_state *st,
+			  struct v4l2_subdev_format *fmt)
+{
+	struct ov9740 *s = to_ov9740(sd);
+
+	if (fmt->pad)
+		return -EINVAL;
+	ov9740_fill_fmt(&fmt->format, fmt->format.width, fmt->format.height);
+	if (fmt->which == V4L2_SUBDEV_FORMAT_TRY) {
+		*v4l2_subdev_state_get_format(st, 0) = fmt->format;
+		return 0;
+	}
+	mutex_lock(&s->lock);
+	s->fmt = fmt->format;
+	mutex_unlock(&s->lock);
+	return 0;
+}
+
+static int ov9740_get_mbus_config(struct v4l2_subdev *sd, unsigned int pad,
+				  struct v4l2_mbus_config *cfg)
+{
+	cfg->type = V4L2_MBUS_CSI2_DPHY;
+	cfg->bus.mipi_csi2.num_data_lanes = 1;
+	cfg->bus.mipi_csi2.flags = 0;	/* horloge continue (MIPI_CTRL00 = 0x44) */
+	return 0;
+}
+
+static int ov9740_init_state(struct v4l2_subdev *sd, struct v4l2_subdev_state *st)
+{
+	ov9740_fill_fmt(v4l2_subdev_state_get_format(st, 0),
+			OV9740_MAX_WIDTH, OV9740_MAX_HEIGHT);
+	return 0;
+}
+
+static int ov9740_pre_streamon(struct v4l2_subdev *sd, u32 flags)
+{
+	struct ov9740 *s = to_ov9740(sd);
+	int ret;
+
+	mutex_lock(&s->lock);
+	ret = ov9740_power_on(s);
+	if (!ret)
+		ret = ov9740_setup(s);
+	if (ret)
+		ov9740_power_off(s);
+	mutex_unlock(&s->lock);
+	return ret;
+}
+
+static int ov9740_post_streamoff(struct v4l2_subdev *sd)
+{
+	struct ov9740 *s = to_ov9740(sd);
+
+	mutex_lock(&s->lock);
+	ov9740_power_off(s);
+	mutex_unlock(&s->lock);
+	return 0;
+}
+
+static int ov9740_s_stream(struct v4l2_subdev *sd, int enable)
+{
+	struct ov9740 *s = to_ov9740(sd);
+	int ret;
+
+	mutex_lock(&s->lock);
+	if (enable) {
+		/* receivers that do not call pre_streamon */
+		if (!s->powered) {
+			ret = ov9740_power_on(s);
+			if (!ret)
+				ret = ov9740_setup(s);
+			if (ret)
+				goto out;
+		}
+		ret = ov9740_write(s, OV9740_MODE_SELECT, 0x01);
+		goto out;
+	}
+	ret = ov9740_write(s, OV9740_MODE_SELECT, 0x00);
+out:
+	mutex_unlock(&s->lock);
+	return ret;
+}
+
+static int ov9740_s_ctrl(struct v4l2_ctrl *ctrl)
+{
+	struct ov9740 *s = container_of(ctrl->handler, struct ov9740, ctrls);
+	u8 ort;
+
+	switch (ctrl->id) {
+	case V4L2_CID_HFLIP:
+	case V4L2_CID_VFLIP:
+		if (!s->powered)	/* applied by ov9740_setup() */
+			return 0;
+		ort = (s->vflip->val ? 0x2 : 0) | (s->hflip->val ? 0x1 : 0);
+		return ov9740_write(s, OV9740_IMAGE_ORT, ort);
+	}
+	return 0;
+}
+
+static const struct v4l2_ctrl_ops ov9740_ctrl_ops = { .s_ctrl = ov9740_s_ctrl };
+
+static const struct v4l2_subdev_video_ops ov9740_video_ops = {
+	.s_stream = ov9740_s_stream,
+	.pre_streamon = ov9740_pre_streamon,
+	.post_streamoff = ov9740_post_streamoff,
+};
+
+static const struct v4l2_subdev_pad_ops ov9740_pad_ops = {
+	.enum_mbus_code = ov9740_enum_mbus_code,
+	.enum_frame_size = ov9740_enum_frame_size,
+	.get_fmt = ov9740_get_fmt,
+	.set_fmt = ov9740_set_fmt,
+	.get_mbus_config = ov9740_get_mbus_config,
+};
+
+static const struct v4l2_subdev_ops ov9740_subdev_ops = {
+	.video = &ov9740_video_ops,
+	.pad = &ov9740_pad_ops,
+};
+
+static const struct v4l2_subdev_internal_ops ov9740_internal_ops = {
+	.init_state = ov9740_init_state,
+};
+
+/* ---- probe ---------------------------------------------------------------- */
+
+static int ov9740_check_endpoint(struct device *dev)
+{
+	struct v4l2_fwnode_endpoint ep = { .bus_type = V4L2_MBUS_CSI2_DPHY };
+	struct fwnode_handle *fw;
+	int ret;
+
+	fw = fwnode_graph_get_next_endpoint(dev_fwnode(dev), NULL);
+	if (!fw)
+		return dev_err_probe(dev, -EINVAL, "no endpoint\n");
+	ret = v4l2_fwnode_endpoint_parse(fw, &ep);
+	fwnode_handle_put(fw);
+	if (ret)
+		return dev_err_probe(dev, ret, "bad endpoint\n");
+	if (ep.bus.mipi_csi2.num_data_lanes != 1)
+		return dev_err_probe(dev, -EINVAL, "one data lane expected\n");
+	return 0;
+}
+
+static int ov9740_probe(struct i2c_client *client)
+{
+	struct device *dev = &client->dev;
+	const s64 *menu;
+	struct ov9740 *s;
+	u8 hi, lo, rev, man;
+	int ret;
+
+	s = devm_kzalloc(dev, sizeof(*s), GFP_KERNEL);
+	if (!s)
+		return -ENOMEM;
+	s->client = client;
+	mutex_init(&s->lock);
+
+	ret = ov9740_check_endpoint(dev);
+	if (ret)
+		return ret;
+
+	s->xclk = devm_clk_get(dev, NULL);
+	if (IS_ERR(s->xclk))
+		return dev_err_probe(dev, PTR_ERR(s->xclk), "no clock\n");
+	ret = clk_set_rate(s->xclk, OV9740_XCLK_HZ);
+	if (ret)
+		dev_warn(dev, "cannot set the clock to 24 MHz (%d)\n", ret);
+	dev_info(dev, "input clock %lu Hz\n", clk_get_rate(s->xclk));
+
+	for (int i = 0; i < ARRAY_SIZE(s->supplies); i++)
+		s->supplies[i].supply = ov9740_supply_names[i];
+	ret = devm_regulator_bulk_get(dev, ARRAY_SIZE(s->supplies), s->supplies);
+	if (ret)
+		return dev_err_probe(dev, ret, "no supplies\n");
+
+	s->pwdn = devm_gpiod_get_optional(dev, "powerdown", GPIOD_OUT_HIGH);
+	if (IS_ERR(s->pwdn))
+		return PTR_ERR(s->pwdn);
+	s->reset = devm_gpiod_get_optional(dev, "reset", GPIOD_OUT_HIGH);
+	if (IS_ERR(s->reset))
+		return PTR_ERR(s->reset);
+
+	ret = ov9740_power_on(s);
+	if (ret)
+		return dev_err_probe(dev, ret, "power on failed\n");
+	ret = ov9740_read(s, OV9740_MODEL_ID_HI, &hi);
+	if (!ret)
+		ret = ov9740_read(s, OV9740_MODEL_ID_LO, &lo);
+	if (!ret)
+		ret = ov9740_read(s, OV9740_REVISION_NUMBER, &rev);
+	if (!ret)
+		ret = ov9740_read(s, OV9740_MANUFACTURER_ID, &man);
+	ov9740_power_off(s);
+	if (ret)
+		return dev_err_probe(dev, ret, "sensor not responding\n");
+	if (((hi << 8) | lo) != 0x9740)
+		return dev_err_probe(dev, -ENODEV, "unexpected model 0x%02x%02x\n", hi, lo);
+	dev_info(dev, "OV9740 revision 0x%02x, manufacturer 0x%02x\n", rev, man);
+
+	ov9740_fill_fmt(&s->fmt, OV9740_MAX_WIDTH, OV9740_MAX_HEIGHT);
+	s->link_freq = (s64)link_freq_mhz * 1000000;
+	menu = &s->link_freq;
+
+	v4l2_ctrl_handler_init(&s->ctrls, 4);
+	/* les tables du vendeur posent 0x0101 = 0x01 : miroir horizontal par défaut */
+	s->hflip = v4l2_ctrl_new_std(&s->ctrls, &ov9740_ctrl_ops, V4L2_CID_HFLIP, 0, 1, 1, 1);
+	s->vflip = v4l2_ctrl_new_std(&s->ctrls, &ov9740_ctrl_ops, V4L2_CID_VFLIP, 0, 1, 1, 0);
+	v4l2_ctrl_new_int_menu(&s->ctrls, NULL, V4L2_CID_LINK_FREQ, 0, 0, menu);
+	v4l2_ctrl_new_std(&s->ctrls, NULL, V4L2_CID_PIXEL_RATE, 1, INT_MAX, 1,
+			  s->link_freq * 2 / 16);
+	if (s->ctrls.error) {
+		ret = s->ctrls.error;
+		goto err_ctrls;
+	}
+
+	v4l2_i2c_subdev_init(&s->sd, client, &ov9740_subdev_ops);
+	s->sd.internal_ops = &ov9740_internal_ops;
+	s->sd.flags |= V4L2_SUBDEV_FL_HAS_DEVNODE;
+	s->sd.ctrl_handler = &s->ctrls;
+	s->sd.entity.function = MEDIA_ENT_F_CAM_SENSOR;
+	s->pad.flags = MEDIA_PAD_FL_SOURCE;
+	ret = media_entity_pads_init(&s->sd.entity, 1, &s->pad);
+	if (ret)
+		goto err_ctrls;
+	s->sd.state_lock = s->ctrls.lock;
+	ret = v4l2_subdev_init_finalize(&s->sd);
+	if (ret)
+		goto err_entity;
+	ret = v4l2_async_register_subdev_sensor(&s->sd);
+	if (ret)
+		goto err_state;
+	return 0;
+
+err_state:
+	v4l2_subdev_cleanup(&s->sd);
+err_entity:
+	media_entity_cleanup(&s->sd.entity);
+err_ctrls:
+	v4l2_ctrl_handler_free(&s->ctrls);
+	return ret;
+}
+
+static void ov9740_remove(struct i2c_client *client)
+{
+	struct v4l2_subdev *sd = i2c_get_clientdata(client);
+	struct ov9740 *s = to_ov9740(sd);
+
+	v4l2_async_unregister_subdev(sd);
+	v4l2_subdev_cleanup(sd);
+	media_entity_cleanup(&sd->entity);
+	v4l2_ctrl_handler_free(&s->ctrls);
+	ov9740_power_off(s);
+}
+
+static const struct of_device_id ov9740_of_match[] = {
+	{ .compatible = "ovti,ov9740" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, ov9740_of_match);
+
+static struct i2c_driver ov9740_driver = {
+	.driver = {
+		.name = "ov9740",
+		.of_match_table = ov9740_of_match,
+	},
+	.probe = ov9740_probe,
+	.remove = ov9740_remove,
+};
+module_i2c_driver(ov9740_driver);
+
+MODULE_DESCRIPTION("OmniVision OV9740 MIPI CSI-2 sensor driver");
+MODULE_AUTHOR("Andrew Chew (original soc_camera driver)");
+MODULE_LICENSE("GPL");
