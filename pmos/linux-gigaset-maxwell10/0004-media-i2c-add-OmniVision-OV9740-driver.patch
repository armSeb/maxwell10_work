From: Maxwell 10 port
Subject: [PATCH] media: i2c: add an OmniVision OV9740 MIPI CSI-2 driver

The OV9740 (720p YUV, one CSI-2 lane) of the Gigaset Maxwell 10 lost its
driver with soc_camera. Port the NVIDIA driver register tables to a
media-controller subdevice: DT clock, supplies, power-down/reset GPIOs,
CSI-2 endpoint, pre_streamon/post_streamoff for the LP-11 handshake of
imx6-mipi-csi2, LINK_FREQ/PIXEL_RATE and flip controls.
---
diff --git a/drivers/media/i2c/Kconfig b/drivers/media/i2c/Kconfig
index 8ba096b8e..670b374d4 100644
--- a/drivers/media/i2c/Kconfig
+++ b/drivers/media/i2c/Kconfig
@@ -642,6 +642,16 @@ config VIDEO_OV9734
 	  To compile this driver as a module, choose M here: the
 	  module's name is ov9734.
 
+config VIDEO_OV9740
+	tristate "OmniVision OV9740 sensor support"
+	depends on OF
+	help
+	  This is a Video4Linux2 sensor driver for the OmniVision
+	  OV9740 720p YUV camera (MIPI CSI-2, one lane).
+
+	  To compile this driver as a module, choose M here: the
+	  module's name is ov9740.
+
 config VIDEO_RDACM20
 	tristate "IMI RDACM20 camera support"
 	select VIDEO_MAX9271_LIB
diff --git a/drivers/media/i2c/Makefile b/drivers/media/i2c/Makefile
index fbb988bd0..503118d37 100644
--- a/drivers/media/i2c/Makefile
+++ b/drivers/media/i2c/Makefile
@@ -114,6 +114,7 @@ obj-$(CONFIG_VIDEO_OV9282) += ov9282.o
 obj-$(CONFIG_VIDEO_OV9640) += ov9640.o
 obj-$(CONFIG_VIDEO_OV9650) += ov9650.o
 obj-$(CONFIG_VIDEO_OV9734) += ov9734.o
+obj-$(CONFIG_VIDEO_OV9740) += ov9740.o
 obj-$(CONFIG_VIDEO_RDACM20) += rdacm20.o
 obj-$(CONFIG_VIDEO_RDACM21) += rdacm21.o
 obj-$(CONFIG_VIDEO_RJ54N1) += rj54n1cb0c.o
