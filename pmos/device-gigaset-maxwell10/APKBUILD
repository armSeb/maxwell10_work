# Reference: <https://postmarketos.org/devicepkg>
pkgname=device-gigaset-maxwell10
pkgdesc="Gigaset Maxwell 10"
pkgver=1
pkgrel=16
url="https://github.com/armSeb/maxwell10_work"
license="MIT"
arch="armv7"
options="!check !archcheck"
depends="
	postmarketos-base
	linux-gigaset-maxwell10
	bluez
	bluez-deprecated
	zstd
	v4l-utils
	libgpiod
	"
makedepends="devicepkg-dev linux-headers"
install="$pkgname.post-install $pkgname.post-upgrade"
subpackages="$pkgname-nonfree-firmware:nonfree_firmware"
source="
	deviceinfo
	60-maxwell-ioscheduler.rules
	dvf99.c
	dvf99.service
	dvf99-service
	80-gigaset-maxwell10.preset
	61-dvf99-pulseaudio.rules
	dvf99-pulse
	dvf99-pulse.service
	dvf99-tmpfiles.conf
	maxwell-bluetooth
	maxwell-bluetooth.service
	80-gigaset-maxwell10-user.preset
	maxwell-camera
	maxwell-camera.service
	62-maxwell-camera.rules
	maxwell-firmware-import
	maxwell-firmware-import.service
	"

build() {
	devicepkg_build $startdir $pkgname
	# outil CMBS de la base DECT / audio (tools/dvf99 du dépôt)
	${CC:-gcc} $CFLAGS -Wall -o dvf99 "$srcdir"/dvf99.c $LDFLAGS -lpthread
}

package() {
	devicepkg_package $startdir $pkgname

	install -Dm644 "$srcdir"/60-maxwell-ioscheduler.rules \
		"$pkgdir"/usr/lib/udev/rules.d/60-maxwell-ioscheduler.rules

	install -Dm755 dvf99 "$pkgdir"/usr/bin/dvf99
	install -Dm755 "$srcdir"/dvf99-service "$pkgdir"/usr/libexec/dvf99-service
	install -Dm644 "$srcdir"/dvf99.service \
		"$pkgdir"/usr/lib/systemd/system/dvf99.service
	install -Dm644 "$srcdir"/80-gigaset-maxwell10.preset \
		"$pkgdir"/usr/lib/systemd/system-preset/80-gigaset-maxwell10.preset
	install -Dm644 "$srcdir"/61-dvf99-pulseaudio.rules \
		"$pkgdir"/usr/lib/udev/rules.d/61-dvf99-pulseaudio.rules
	install -Dm755 "$srcdir"/dvf99-pulse "$pkgdir"/usr/libexec/dvf99-pulse
	install -Dm644 "$srcdir"/dvf99-pulse.service \
		"$pkgdir"/usr/lib/systemd/user/dvf99-pulse.service
	install -Dm644 "$srcdir"/80-gigaset-maxwell10-user.preset \
		"$pkgdir"/usr/lib/systemd/user-preset/80-gigaset-maxwell10.preset
	install -Dm644 "$srcdir"/dvf99-tmpfiles.conf "$pkgdir"/usr/lib/tmpfiles.d/dvf99.conf
	install -Dm755 "$srcdir"/maxwell-bluetooth "$pkgdir"/usr/libexec/maxwell-bluetooth
	install -Dm644 "$srcdir"/maxwell-bluetooth.service \
		"$pkgdir"/usr/lib/systemd/system/maxwell-bluetooth.service
	install -Dm755 "$srcdir"/maxwell-camera "$pkgdir"/usr/libexec/maxwell-camera
	install -Dm644 "$srcdir"/maxwell-camera.service \
		"$pkgdir"/usr/lib/systemd/system/maxwell-camera.service
	install -Dm644 "$srcdir"/62-maxwell-camera.rules \
		"$pkgdir"/usr/lib/udev/rules.d/62-maxwell-camera.rules
	install -Dm755 "$srcdir"/maxwell-firmware-import "$pkgdir"/usr/libexec/maxwell-firmware-import
	install -Dm644 "$srcdir"/maxwell-firmware-import.service \
		"$pkgdir"/usr/lib/systemd/system/maxwell-firmware-import.service
}

nonfree_firmware() {
	pkgdesc="Firmwares non libres : Wi-Fi AR6003, Bluetooth AR3002, SDMA i.MX6"
	depends="
		linux-firmware-ath6k
		linux-firmware-ar3k
		linux-firmware-imx
		"
	mkdir "$subpkgdir"
}

# Sommes générées par : pmbootstrap checksum device-gigaset-maxwell10
sha512sums=""
