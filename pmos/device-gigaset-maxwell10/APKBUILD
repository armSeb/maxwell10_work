# Reference: <https://postmarketos.org/devicepkg>
pkgname=device-gigaset-maxwell10
pkgdesc="Gigaset Maxwell 10"
pkgver=1
pkgrel=1
url="https://github.com/armSeb/maxwell10_work"
license="MIT"
arch="armv7"
options="!check !archcheck"
depends="
	postmarketos-base
	linux-gigaset-maxwell10
	linux-firmware-ath6k
	"
# Le firmware Wi-Fi est une dépendance directe (et non un sous-paquet
# -nonfree-firmware) : pmbootstrap 3.x ne l'installait pas, l'installation doit
# être reproductible sans question.
makedepends="devicepkg-dev"
source="deviceinfo"

build() {
	devicepkg_build $startdir $pkgname
}

package() {
	devicepkg_package $startdir $pkgname
}

# Sommes générées par : pmbootstrap checksum device-gigaset-maxwell10
sha512sums=""
