#!/bin/sh
# Ajoute à la session PulseAudio de l'utilisateur les sorties « Haut-parleur » et
# « Combiné » et l'entrée « Micro du combiné » servies par dvf99.service (tubes
# mono 16 kHz dans /run/dvf99). Lancé par l'unité utilisateur dvf99-pulse.service,
# qui ne tourne pas pour les comptes système (greeter).
d=/run/dvf99
for i in $(seq 30); do pactl info >/dev/null 2>&1 && break; sleep 1; done
for i in $(seq 30); do [ -p "$d/speaker" ] && break; sleep 1; done
loaded() { pactl list short modules | grep -q "file=$d/$1"; }
loaded speaker || pactl load-module module-pipe-sink file="$d/speaker" sink_name=dvf99_speaker \
	format=s16le rate=16000 channels=1 use_system_clock_for_timing=yes \
	sink_properties=device.description=Haut-parleur
loaded handset || pactl load-module module-pipe-sink file="$d/handset" sink_name=dvf99_handset \
	format=s16le rate=16000 channels=1 use_system_clock_for_timing=yes \
	sink_properties=device.description=Combiné
# module-pipe-source refuse un tube existant : on retire le nôtre s'il en reste un
if ! loaded mic; then
	[ -p "$d/mic" ] && [ -O "$d/mic" ] && rm -f "$d/mic"
	pactl load-module module-pipe-source file="$d/mic" source_name=dvf99_mic \
		format=s16le rate=16000 channels=1 source_properties=device.description=Micro_du_combiné
fi
pactl set-default-sink dvf99_speaker
pactl set-default-source dvf99_mic
exit 0
