[Unit]
Description=Sorties et entrées audio de la DVF9919 dans PulseAudio
After=pulseaudio.service
Wants=pulseaudio.service
StartLimitIntervalSec=0
# pas pour les comptes système (greeter greetd/phrog) : leur PulseAudio prendrait les tubes
ConditionUser=!@system

[Service]
# surveille et recharge les modules s'ils disparaissent (voir le script)
Type=simple
ExecStart=/usr/libexec/dvf99-pulse
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
