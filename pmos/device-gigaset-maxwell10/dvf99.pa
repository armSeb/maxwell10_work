# Sorties / entrée audio de la DVF9919 (haut-parleur, combiné DECT), servies par
# dvf99.service (dvf99 -A) sous forme de tubes mono 16 kHz. La carte ALSA « DVF99 »
# elle-même est ignorée par PulseAudio (règle udev 61-dvf99-pulseaudio.rules).
.nofail
load-module module-pipe-sink file=/run/dvf99/speaker sink_name=dvf99_speaker format=s16le rate=16000 channels=1 use_system_clock_for_timing=yes sink_properties=device.description=Haut-parleur
load-module module-pipe-sink file=/run/dvf99/handset sink_name=dvf99_handset format=s16le rate=16000 channels=1 use_system_clock_for_timing=yes sink_properties=device.description=Combiné
# le tube du micro est créé par PulseAudio (module-pipe-source refuse un tube existant)
load-module module-pipe-source file=/run/dvf99/mic source_name=dvf99_mic format=s16le rate=16000 channels=1 source_properties=device.description=Micro_du_combiné
set-default-sink dvf99_speaker
set-default-source dvf99_mic
.fail
