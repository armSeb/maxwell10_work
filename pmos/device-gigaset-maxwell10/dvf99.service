# Base DECT / audio DSPG DVF9919 (protocole CMBS sur /dev/ttymxc2) :
# démarre sa pile, émule son EEPROM et ouvre le chemin haut-parleur, pour que la
# moteur audio (tubes /run/dvf99 pour PulseAudio) et décroché du combiné. Voir docs/dect-cmbs.md.
[Unit]
Description=Base DECT et haut-parleur (DVF9919, CMBS)
After=systemd-udevd.service

[Service]
Type=simple
EnvironmentFile=-/etc/default/dvf99
ExecStart=/usr/libexec/dvf99-service
StateDirectory=dvf99
RuntimeDirectory=dvf99
RuntimeDirectoryPreserve=yes
RuntimeDirectoryMode=1777
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
