#!/bin/sh
# Lancé par dvf99.service. Réglages facultatifs dans /etc/default/dvf99 :
#   DVF99_NVRAM=/var/lib/dvf99/nvram.bin   EEPROM émulée (copie du nvram.bin d'Android)
#   DVF99_GAIN=32                          gain HP : 32 = 0 dB … 36 = −24 dB
#   DVF99_TWEETER=50                       niveau du tweeter en % (aigus saturés à 100)
#   DVF99_OPTS=                            autres options de dvf99 (ex. -N : pas de décroché auto,
#                                          -Z 30 : veille du HP après 30 s de silence, -Z 0 : jamais)
nv=${DVF99_NVRAM:-/var/lib/dvf99/nvram.bin}
set -- -q -A -g "${DVF99_GAIN:-32}" -X "${DVF99_TWEETER:-50}" $DVF99_OPTS
if [ -f "$nv" ]; then
	set -- -e "$nv" "$@"
else
	echo "dvf99 : pas d'EEPROM $nv — copier le nvram.bin d'Android (appairages, calibration)" >&2
fi
exec /usr/bin/dvf99 "$@" service
