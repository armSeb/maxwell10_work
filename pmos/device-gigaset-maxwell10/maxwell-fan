#!/bin/sh
# Pilotage du ventilateur (tout ou rien) du Gigaset Maxwell 10 selon la
# température du SoC : marche à FAN_ON, arrêt à FAN_OFF (hystérésis).
# En cas d'arrêt du service ou d'erreur de lecture : ventilateur en MARCHE.
# Seuils en millidegrés, modifiables dans /etc/default/maxwell-fan.
FAN_ON=65000
FAN_OFF=55000
INTERVAL=${INTERVAL:-5}
# shellcheck disable=SC1091
[ -r /etc/default/maxwell-fan ] && . /etc/default/maxwell-fan

tz=; fan=
S=${SYSFS:-/sys}	# SYSFS=… pour tester hors de la tablette
for z in "$S"/class/thermal/thermal_zone*; do
	[ "$(cat "$z/type" 2>/dev/null)" = imx_thermal_zone ] && tz=$z/temp
done
for h in "$S"/class/hwmon/hwmon*; do
	[ "$(cat "$h/name" 2>/dev/null)" = gpio_fan ] && fan=$h
done
[ -n "$tz" ] || { echo "maxwell-fan: zone imx_thermal_zone introuvable" >&2; exit 1; }
[ -n "$fan" ] || { echo "maxwell-fan: hwmon gpio_fan introuvable" >&2; exit 1; }

set_fan() { echo "$1" > "$fan/pwm1"; }
echo 1 > "$fan/pwm1_enable"
trap 'set_fan 255; exit 0' INT TERM EXIT
set_fan 255
on=1
while :; do
	if ! t=$(cat "$tz" 2>/dev/null) || [ -z "$t" ]; then
		set_fan 255; on=1
	elif [ "$on" = 0 ] && [ "$t" -ge "$FAN_ON" ]; then
		set_fan 255; on=1
	elif [ "$on" = 1 ] && [ "$t" -le "$FAN_OFF" ]; then
		set_fan 0; on=0
	fi
	sleep "$INTERVAL"
done
