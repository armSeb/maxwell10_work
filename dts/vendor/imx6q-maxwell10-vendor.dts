/dts-v1/;

/ {
	compatible = "gc,imx6q-maxwell\0fsl,imx6q";
	hardware_revision = [39];
	#address-cells = <0x01>;
	#size-cells = <0x01>;
	model = [47 69 67 61 73 65 74 20 69 2e 4d 58 36 20 51 75 61 64 20 6d 61 78 31 30 20 42 6f 61 72 64];
	hardware = [6d 61 78 31 30];

	v4l2_out {
		compatible = "fsl,mxc_v4l2_output";
		status = "okay";
	};

	bt_rfkill {
		compatible = "fsl,mxc_bt_rfkill";
		bt-power-gpios = <0x34 0x07 0x01>;
		status = "okay";
	};

	aliases {
		gpio3 = "/soc/aips-bus@02000000/gpio@020a8000";
		serial4 = "/soc/aips-bus@02100000/serial@021f4000";
		gpio6 = "/soc/aips-bus@02000000/gpio@020b4000";
		i2c1 = "/soc/aips-bus@02100000/i2c@021a4000";
		spi2 = "/soc/aips-bus@02000000/spba-bus@02000000/ecspi@02010000";
		gpio5 = "/soc/aips-bus@02000000/gpio@020b0000";
		gpio2 = "/soc/aips-bus@02000000/gpio@020a4000";
		usbphy0 = "/soc/aips-bus@02000000/usbphy@020c9000";
		hdmi_display = "/fb@1";
		spi0 = "/soc/aips-bus@02000000/spba-bus@02000000/ecspi@02008000";
		usbphy1 = "/soc/aips-bus@02000000/usbphy@020ca000";
		gpio4 = "/soc/aips-bus@02000000/gpio@020ac000";
		serial2 = "/soc/aips-bus@02100000/serial@021ec000";
		mmc2 = "/soc/aips-bus@02100000/usdhc@02198000";
		serial1 = "/soc/aips-bus@02100000/serial@021e8000";
		mmc0 = "/soc/aips-bus@02100000/usdhc@02190000";
		spi1 = "/soc/aips-bus@02000000/spba-bus@02000000/ecspi@0200c000";
		ipu0 = "/soc/ipu@02400000";
		gpio1 = "/soc/aips-bus@02000000/gpio@020a0000";
		ipu1 = "/soc/ipu@02800000";
		gpio0 = "/soc/aips-bus@02000000/gpio@0209c000";
		i2c0 = "/soc/aips-bus@02100000/i2c@021a0000";
		spi3 = "/soc/aips-bus@02000000/spba-bus@02000000/ecspi@02014000";
		mmc1 = "/soc/aips-bus@02100000/usdhc@02194000";
		mxcfb1 = "/fb@1";
		i2c2 = "/soc/aips-bus@02100000/i2c@021a8000";
		mmc3 = "/soc/aips-bus@02100000/usdhc@0219c000";
		mxcfb0 = "/fb@0";
		lvds_display = "/fb@0";
		serial3 = "/soc/aips-bus@02100000/serial@021f0000";
		serial0 = "/soc/aips-bus@02000000/spba-bus@02000000/serial@02020000";
	};

	soc {
		compatible = "simple-bus";
		interrupt-parent = <0x01>;
		#address-cells = <0x01>;
		#size-cells = <0x01>;
		ranges;

		imx_ion {
			compatible = "fsl,mxc-ion";
			fsl,heap-id = <0x00>;
		};

		hdmi_core@00120000 {
			compatible = "fsl,imx6q-hdmi-core";
			ipu_id = <0x00>;
			reg = <0x120000 0x9000>;
			clocks = <0x02 0x7c 0x02 0x7b 0x02 0x8a>;
			clock-names = "hdmi_isfr\0hdmi_iahb\0mipi_core";
			status = "okay";
			disp_id = <0x00>;
		};

		hdmi_cec@00120000 {
			compatible = "fsl,imx6q-hdmi-cec";
			interrupts = <0x00 0x73 0x04>;
			pinctrl-0 = <0x05>;
			status = "okay";
			pinctrl-names = "default";
		};

		gpu@00130000 {
			resets = <0x0b 0x00 0x0b 0x03 0x0b 0x03>;
			compatible = "fsl,imx6q-gpu";
			interrupts = <0x00 0x09 0x04 0x00 0x0a 0x04 0x00 0x0b 0x04>;
			reg = <0x130000 0x4000 0x134000 0x4000 0x2204000 0x4000 0x00 0x00>;
			reg-names = "iobase_3d\0iobase_2d\0iobase_vg\0phys_baseaddr";
			clocks = <0x02 0x1a 0x02 0x8f 0x02 0x1b 0x02 0x79 0x02 0x7a 0x02 0x4a>;
			reset-names = "gpu3d\0gpu2d\0gpuvg";
			interrupt-names = "irq_3d\0irq_2d\0irq_vg";
			clock-names = "gpu2d_axi_clk\0openvg_axi_clk\0gpu3d_axi_clk\0gpu2d_clk\0gpu3d_clk\0gpu3d_shader_clk";
			power-domains = <0x0c 0x01>;
		};

		pcie@0x01000000 {
			compatible = "fsl,imx6q-pcie\0snps,dw-pcie";
			interrupts = <0x00 0x78 0x04>;
			#interrupt-cells = <0x01>;
			#address-cells = <0x03>;
			num-lanes = <0x01>;
			#size-cells = <0x02>;
			reg = <0x1ffc000 0x4000 0x1f00000 0x80000>;
			device_type = "pci";
			ranges = <0x81000000 0x00 0x00 0x1f80000 0x00 0x10000 0x82000000 0x00 0x1000000 0x1000000 0x00 0xf00000>;
			reg-names = "dbi\0config";
			clocks = <0x02 0xbd 0x02 0xbb 0x02 0xce 0x02 0x90>;
			interrupt-map-mask = <0x00 0x00 0x00 0x07>;
			interrupt-names = "msi";
			clock-names = "pcie_phy\0ref_100m\0pcie_bus\0pcie";
			status = "disabled";
			interrupt-map = <0x00 0x00 0x00 0x01 0x01 0x00 0x7b 0x04 0x00 0x00 0x00 0x02 0x01 0x00 0x7a 0x04 0x00 0x00 0x00 0x03 0x01 0x00 0x79 0x04 0x00 0x00 0x00 0x04 0x01 0x00 0x78 0x04>;
		};

		hdmi_video@020e0000 {
			compatible = "fsl,imx6q-hdmi-video";
			fsl,phy_reg_vlev = <0x294>;
			interrupts = <0x00 0x73 0x04>;
			reg = <0x20e0000 0x1000>;
			reg-names = "hdmi_gpr";
			clocks = <0x02 0x7c 0x02 0x7b 0x02 0x8a>;
			fsl,phy_reg_cksymtx = <0x800d>;
			clock-names = "hdmi_isfr\0hdmi_iahb\0mipi_core";
			status = "okay";
		};

		sata@02200000 {
			compatible = "fsl,imx6q-ahci";
			interrupts = <0x00 0x27 0x04>;
			reg = <0x2200000 0x4000>;
			clocks = <0x02 0x9a 0x02 0xbb 0x02 0x69>;
			clock-names = "sata\0sata_ref\0ahb";
			status = "disabled";
		};

		caam-sm@00100000 {
			compatible = "fsl,imx6q-caam-sm";
			reg = <0x100000 0x3fff>;
		};

		sram@00900000 {
			compatible = "fsl,lpm-sram";
			reg = <0x900000 0x4000>;
			clocks = <0x02 0x8e>;
		};

		ipu@02800000 {
			resets = <0x0b 0x04>;
			compatible = "fsl,imx6q-ipu";
			interrupts = <0x00 0x08 0x04 0x00 0x07 0x04>;
			reg = <0x2800000 0x400000>;
			clocks = <0x02 0x85 0x02 0x86 0x02 0x89 0x02 0x29 0x02 0x2a 0x02 0x87 0x02 0x88>;
			bypass_reset = <0x00>;
			clock-names = "bus\0di0\0di1\0di0_sel\0di1_sel\0ldb_di0\0ldb_di1";
		};

		hdmi_audio@00120000 {
			linux,phandle = <0x39>;
			compatible = "fsl,imx6q-hdmi-audio";
			dmas = <0x04 0x02 0x18 0x00>;
			clocks = <0x02 0x7c 0x02 0x7b 0x02 0x8a>;
			phandle = <0x39>;
			clock-names = "hdmi_isfr\0hdmi_iahb\0mipi_core";
			dma-names = "tx";
			status = "okay";
		};

		sram@00904000 {
			compatible = "fsl,ddr-lpm-sram";
			reg = <0x904000 0x1000>;
			clocks = <0x02 0x8e>;
		};

		aips-bus@02000000 {
			compatible = "fsl,aips-bus\0simple-bus";
			#address-cells = <0x01>;
			#size-cells = <0x01>;
			reg = <0x2000000 0x100000>;
			ranges;

			epit@020d0000 {
				interrupts = <0x00 0x38 0x04>;
				reg = <0x20d0000 0x4000>;
			};

			gpio@020a8000 {
				linux,phandle = <0x34>;
				compatible = "fsl,imx6q-gpio\0fsl,imx35-gpio";
				interrupts = <0x00 0x48 0x04 0x00 0x49 0x04>;
				#interrupt-cells = <0x02>;
				gpio-controller;
				#gpio-cells = <0x02>;
				reg = <0x20a8000 0x4000>;
				phandle = <0x34>;
				interrupt-controller;
			};

			src@020d8000 {
				#reset-cells = <0x01>;
				linux,phandle = <0x0b>;
				compatible = "fsl,imx6q-src\0fsl,imx51-src";
				interrupts = <0x00 0x5b 0x04 0x00 0x60 0x04>;
				reg = <0x20d8000 0x4000>;
				phandle = <0x0b>;
			};

			anatop@020c8000 {
				linux,phandle = <0x0f>;
				compatible = "fsl,imx6q-anatop\0syscon\0simple-bus";
				interrupts = <0x00 0x31 0x04 0x00 0x36 0x04 0x00 0x7f 0x04>;
				reg = <0x20c8000 0x1000>;
				phandle = <0x0f>;

				regulator-2p5@130 {
					anatop-reg-offset = <0x130>;
					regulator-max-microvolt = <0x29f630>;
					compatible = "fsl,anatop-regulator";
					anatop-vol-bit-width = <0x05>;
					regulator-min-microvolt = <0x1e8480>;
					regulator-always-on;
					anatop-max-voltage = <0x29f630>;
					anatop-min-bit-val = <0x00>;
					anatop-vol-bit-shift = <0x08>;
					regulator-name = "vdd2p5";
					anatop-min-voltage = <0x1e8480>;
					anatop-enable-bit = <0x00>;
				};

				regulator-vddpu@140 {
					linux,phandle = <0x12>;
					anatop-delay-bit-shift = <0x1a>;
					anatop-reg-offset = <0x140>;
					regulator-max-microvolt = <0x162010>;
					compatible = "fsl,anatop-regulator";
					anatop-delay-bit-width = <0x02>;
					anatop-vol-bit-width = <0x05>;
					regulator-min-microvolt = <0xb1008>;
					anatop-delay-reg-offset = <0x170>;
					regulator-enable-ramp-delay = <0x96>;
					anatop-max-voltage = <0x162010>;
					anatop-min-bit-val = <0x01>;
					phandle = <0x12>;
					anatop-vol-bit-shift = <0x09>;
					regulator-allow-bypass;
					regulator-name = "vddpu";
					anatop-min-voltage = <0xb1008>;
					regulator-boot-on;
				};

				regulator-1p1@110 {
					anatop-reg-offset = <0x110>;
					regulator-max-microvolt = <0x14fb18>;
					compatible = "fsl,anatop-regulator";
					anatop-vol-bit-width = <0x05>;
					regulator-min-microvolt = "\0\f5";
					regulator-always-on;
					anatop-max-voltage = <0x14fb18>;
					anatop-min-bit-val = <0x04>;
					anatop-vol-bit-shift = <0x08>;
					regulator-name = "vdd1p1";
					anatop-min-voltage = "\0\f5";
					anatop-enable-bit = <0x00>;
				};

				regulator-3p0@120 {
					linux,phandle = <0x11>;
					anatop-reg-offset = <0x120>;
					regulator-max-microvolt = <0x33e140>;
					compatible = "fsl,anatop-regulator";
					anatop-vol-bit-width = <0x05>;
					regulator-min-microvolt = <0x280de8>;
					anatop-max-voltage = <0x33e140>;
					anatop-min-bit-val = <0x00>;
					phandle = <0x11>;
					anatop-vol-bit-shift = <0x08>;
					regulator-name = "vdd3p0";
					anatop-min-voltage = <0x280de8>;
					anatop-enable-bit = <0x00>;
				};

				regulator-vddsoc@140 {
					linux,phandle = <0x33>;
					anatop-delay-bit-shift = <0x1c>;
					anatop-reg-offset = <0x140>;
					regulator-max-microvolt = <0x162010>;
					compatible = "fsl,anatop-regulator";
					anatop-delay-bit-width = <0x02>;
					anatop-vol-bit-width = <0x05>;
					regulator-min-microvolt = <0xb1008>;
					anatop-delay-reg-offset = <0x170>;
					regulator-always-on;
					anatop-max-voltage = <0x162010>;
					anatop-min-bit-val = <0x01>;
					phandle = <0x33>;
					anatop-vol-bit-shift = <0x12>;
					regulator-allow-bypass;
					regulator-name = "vddsoc";
					anatop-min-voltage = <0xb1008>;
				};

				regulator-vddcore@140 {
					linux,phandle = <0x32>;
					anatop-delay-bit-shift = <0x18>;
					anatop-reg-offset = <0x140>;
					regulator-max-microvolt = <0x162010>;
					compatible = "fsl,anatop-regulator";
					anatop-delay-bit-width = <0x02>;
					anatop-vol-bit-width = <0x05>;
					regulator-min-microvolt = <0xb1008>;
					anatop-delay-reg-offset = <0x170>;
					regulator-always-on;
					anatop-max-voltage = <0x162010>;
					anatop-min-bit-val = <0x01>;
					phandle = <0x32>;
					anatop-vol-bit-shift = <0x00>;
					regulator-allow-bypass;
					regulator-name = "vddarm";
					anatop-min-voltage = <0xb1008>;
				};
			};

			gpio@020b4000 {
				linux,phandle = <0x40>;
				compatible = "fsl,imx6q-gpio\0fsl,imx35-gpio";
				interrupts = <0x00 0x4e 0x04 0x00 0x4f 0x04>;
				#interrupt-cells = <0x02>;
				gpio-controller;
				#gpio-cells = <0x02>;
				reg = <0x20b4000 0x4000>;
				phandle = <0x40>;
				interrupt-controller;
			};

			vpu@02040000 {
				resets = <0x0b 0x01>;
				iram = <0x0a>;
				compatible = "fsl,imx6-vpu";
				interrupts = <0x00 0x03 0x01 0x00 0x0c 0x04>;
				reg = <0x2040000 0x3c000>;
				reg-names = "vpu_regs";
				clocks = <0x02 0xa8 0x02 0x8c 0x02 0x8e>;
				interrupt-names = "vpu_jpu_irq\0vpu_ipi_irq";
				clock-names = "vpu_clk\0mmdc_ch0_axi\0ocram";
				iramsize = <0x21000>;
				power-domains = <0x0c 0x01>;
			};

			gpc@020dc000 {
				linux,phandle = <0x0c>;
				compatible = "fsl,imx6q-gpc";
				interrupts = <0x00 0x59 0x04 0x00 0x5a 0x04>;
				fsl,wdog-reset = <0x01>;
				reg = <0x20dc000 0x4000>;
				clocks = <0x02 0x7a 0x02 0x4a 0x02 0x79 0x02 0x1a 0x02 0x8f 0x02 0xa8 0x02 0x3e>;
				phandle = <0x0c>;
				fsl,ldo-bypass = <0x00>;
				#power-domain-cells = <0x01>;
				pu-supply = <0x12>;
			};

			gpio@020b0000 {
				compatible = "fsl,imx6q-gpio\0fsl,imx35-gpio";
				interrupts = <0x00 0x4c 0x04 0x00 0x4d 0x04>;
				#interrupt-cells = <0x02>;
				gpio-controller;
				#gpio-cells = <0x02>;
				reg = <0x20b0000 0x4000>;
				interrupt-controller;
			};

			pwm@0208c000 {
				compatible = "fsl,imx6q-pwm\0fsl,imx27-pwm";
				interrupts = <0x00 0x56 0x04>;
				reg = <0x208c000 0x4000>;
				clocks = <0x02 0x3e 0x02 0x94>;
				#pwm-cells = <0x02>;
				clock-names = "ipg\0per";
			};

			dcic@020e8000 {
				compatible = "fsl,imx6q-dcic";
				interrupts = <0x00 0x7d 0x04>;
				reg = <0x20e8000 0x4000>;
				clocks = <0x02 0xd7 0x02 0xd7>;
				clock-names = "dcic\0disp-axi";
				status = "disabled";
				gpr = <0x0e>;
			};

			pwm@02088000 {
				compatible = "fsl,imx6q-pwm\0fsl,imx27-pwm";
				interrupts = <0x00 0x55 0x04>;
				reg = <0x2088000 0x4000>;
				clocks = <0x02 0x3e 0x02 0x93>;
				#pwm-cells = <0x02>;
				clock-names = "ipg\0per";
			};

			spba-bus@02000000 {
				compatible = "fsl,spba-bus\0simple-bus";
				#address-cells = <0x01>;
				#size-cells = <0x01>;
				reg = <0x2000000 0x40000>;
				ranges;

				ssi@0202c000 {
					linux,phandle = <0x35>;
					fsl,fifo-depth = <0x0f>;
					compatible = "fsl,imx6q-ssi\0fsl,imx21-ssi";
					interrupts = <0x00 0x2f 0x04>;
					fsl,ssi-asynchronous;
					dmas = <0x04 0x29 0x16 0x00 0x04 0x2a 0x16 0x00>;
					reg = <0x202c000 0x4000>;
					clocks = <0x02 0xb3 0x02 0x9e>;
					fsl,ssi-dma-events = <0x2a 0x29>;
					phandle = <0x35>;
					clock-names = "ipg\0baud";
					dma-names = "rx\0tx";
					status = "okay";
				};

				asrc@02034000 {
					compatible = "fsl,imx53-asrc";
					interrupts = <0x00 0x32 0x04>;
					dmas = <0x04 0x11 0x17 0x01 0x04 0x12 0x17 0x01 0x04 0x13 0x17 0x01 0x04 0x14 0x17 0x01 0x04 0x15 0x17 0x01 0x04 0x16 0x17 0x01>;
					reg = <0x2034000 0x4000>;
					clocks = <0x02 0xda 0x02 0xdb 0x02 0x00 0x02 0x00 0x02 0x00 0x02 0x00 0x02 0x00 0x02 0x00 0x02 0x00 0x02 0x00 0x02 0x00 0x02 0x00 0x02 0x00 0x02 0x00 0x02 0x00 0x02 0x6b 0x02 0x00 0x02 0x00 0x02 0x9c>;
					fsl,asrc-rate = <0xbb80>;
					clock-names = "mem\0ipg\0asrck_0\0asrck_1\0asrck_2\0asrck_3\0asrck_4\0asrck_5\0asrck_6\0asrck_7\0asrck_8\0asrck_9\0asrck_a\0asrck_b\0asrck_c\0asrck_d\0asrck_e\0asrck_f\0dma";
					fsl,asrc-width = <0x10>;
					dma-names = "rxa\0rxb\0rxc\0txa\0txb\0txc";
					status = "okay";
				};

				spba@0203c000 {
					reg = <0x203c000 0x4000>;
				};

				esai@02024000 {
					compatible = "fsl,imx35-esai";
					interrupts = <0x00 0x33 0x04>;
					dmas = <0x04 0x17 0x15 0x00 0x04 0x18 0x15 0x00>;
					reg = <0x2024000 0x4000>;
					clocks = <0x02 0xd9 0x02 0xd0 0x02 0x76 0x02 0xd9 0x02 0x9c>;
					clock-names = "core\0mem\0extal\0fsys\0dma";
					dma-names = "rx\0tx";
					status = "disabled";
				};

				ecspi@02008000 {
					compatible = "fsl,imx6q-ecspi\0fsl,imx51-ecspi";
					interrupts = <0x00 0x1f 0x04>;
					#address-cells = <0x01>;
					dmas = <0x04 0x03 0x07 0x01 0x04 0x04 0x07 0x02>;
					#size-cells = <0x00>;
					reg = <0x2008000 0x4000>;
					clocks = <0x02 0x70 0x02 0x70>;
					clock-names = "ipg\0per";
					dma-names = "rx\0tx";
					status = "disabled";
				};

				ecspi@02014000 {
					compatible = "fsl,imx6q-ecspi\0fsl,imx51-ecspi";
					interrupts = <0x00 0x22 0x04>;
					#address-cells = <0x01>;
					dmas = <0x04 0x09 0x07 0x01 0x04 0x0a 0x07 0x02>;
					#size-cells = <0x00>;
					reg = <0x2014000 0x4000>;
					fsl,spi-num-chipselects = <0x01>;
					clocks = <0x02 0x73 0x02 0x73>;
					clock-names = "ipg\0per";
					dma-names = "rx\0tx";
					cs-gpios = <0x06 0x14 0x00>;
					pinctrl-0 = <0x07 0x08>;
					status = "okay";
					pinctrl-names = "default";

					w25q16@0 {
						compatible = "st,m25p32";
						#address-cells = <0x01>;
						#size-cells = <0x01>;
						reg = <0x00>;
						spi-max-frequency = <0x1312d00>;

						mtd@00100000 {
							label = "kernel";
							reg = <0x100000 0x100000>;
						};

						mtd0@00000000 {
							label = "bootloader";
							reg = <0x00 0x100000>;
						};
					};
				};

				ssi@02030000 {
					linux,phandle = <0x37>;
					fsl,fifo-depth = <0x0f>;
					compatible = "fsl,imx6q-ssi\0fsl,imx21-ssi";
					interrupts = <0x00 0x30 0x04>;
					dmas = <0x04 0x2d 0x16 0x00 0x04 0x2e 0x16 0x00>;
