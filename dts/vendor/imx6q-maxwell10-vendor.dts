		compatible = "pwm-backlight";
		default-brightness-level = <0x5e>;
		brightness-levels = <0x00 0x07 0x08 0x09 0x0a 0x0b 0x0c 0x0d 0x0e 0x0f 0x10 0x11 0x12 0x13 0x14 0x15 0x16 0x17 0x18 0x19 0x1a 0x1b 0x1c 0x1d 0x1e 0x1f 0x20 0x21 0x22 0x23 0x24 0x25 0x26 0x27 0x28 0x29 0x2a 0x2b 0x2c 0x2d 0x2e 0x2f 0x30 0x31 0x32 0x33 0x34 0x35 0x36 0x37 0x38 0x39 0x3a 0x3b 0x3c 0x3d 0x3e 0x3f 0x40 0x41 0x42 0x43 0x44 0x45 0x46 0x47 0x48 0x49 0x4a 0x4b 0x4c 0x4d 0x4e 0x4f 0x50 0x51 0x52 0x53 0x54 0x55 0x56 0x57 0x58 0x59 0x5a 0x5b 0x5c 0x5d 0x5e 0x5f 0x60 0x61 0x62 0x63 0x64>;
		pwms = <0x3a 0x00 0xc350>;
	};

	dsa@0 {
		resets = <0x3b>;
		dsa,ethernet = <0x3d>;
		compatible = "marvell,dsa";
		#address-cells = <0x01>;
		#size-cells = <0x00>;
		status = "okay";
		dsa,mii-bus = <0x3e>;

		switch@0 {
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			reg = <0x00 0x00>;

			port@4 {
				label = "pc";
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				reg = <0x04>;
			};

			port@3 {
				label = "lan";
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				reg = <0x03>;
			};

			port@5 {
				label = "cpu";
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				reg = <0x05>;
			};
		};
	};

	wlan-reset {
		#reset-cells = <0x00>;
		compatible = "gpio-reset";
		reset-delay-us = <0x2710>;
		reset-gpios = <0x26 0x08 0x01>;
	};

	chosen {
		bootargs = "console=ttymxc1,115200 init=/init video=mxcfb0:dev=ldb,bpp=32 video=mxcfb1:dev=hdmi,bpp=32 video=mxcfb2:off video=mxcfb3:off vmalloc=256M androidboot.console=ttymxc1 consoleblank=0 androidboot.hardware=gigaset cma=384M androidboot.selinux=enforcing androidboot.dm_verity=disabled";
		linux,revision = <0x63015>;
	};

	regulators {
		compatible = "simple-bus";
		#address-cells = <0x01>;
		#size-cells = <0x00>;

		regulator@2 {
			linux,phandle = <0x17>;
			regulator-max-microvolt = <0x4c4b40>;
			compatible = "regulator-fixed";
			regulator-min-microvolt = <0x4c4b40>;
			reg = <0x02>;
			gpio = <0x06 0x16 0x00>;
			phandle = <0x17>;
			regulator-name = "usb_otg_vbus";
			enable-active-high;
		};

		regulator@3 {
			linux,phandle = <0x23>;
			regulator-max-microvolt = <0x1b7740>;
			compatible = "regulator-fixed";
			regulator-min-microvolt = <0x1b7740>;
			regulator-always-on;
			reg = <0x03>;
			phandle = <0x23>;
			regulator-name = "1P8V";
		};

		regulator@0 {
			linux,phandle = <0x24>;
			regulator-max-microvolt = <0x2625a0>;
			compatible = "regulator-fixed";
			regulator-min-microvolt = <0x2625a0>;
			regulator-always-on;
			reg = <0x00>;
			phandle = <0x24>;
			regulator-name = "2P5V";
		};

		regulator@1 {
			linux,phandle = <0x1e>;
			regulator-max-microvolt = <0x325aa0>;
			compatible = "regulator-fixed";
			regulator-min-microvolt = <0x325aa0>;
			regulator-always-on;
			reg = <0x01>;
			phandle = <0x1e>;
			regulator-name = "3P3V";
		};
	};

	cooling-fan {
		compatible = "gpio-fan";
		cooling-min-level = <0x00>;
		gpios = <0x34 0x17 0x00>;
		#cooling-cells = <0x02>;
		gpio-fan,speed-map = <0x00 0x00 0xbb8 0x01>;
		cooling-max-level = <0x01>;
	};

	poe {
		compatible = "gc,maxwell-poe";
		poe_det_gpio = <0x34 0x18 0x00>;
		pinctrl-0 = <0x41>;
		status = "okay";
		pinctrl-names = "default";
	};

	mv88e6xxx {
		resets = <0x3b>;
		pinctrl-0 = <0x3c>;
		status = "okay";
	};

	sound-hdmi {
		compatible = "fsl,imx6q-audio-hdmi\0fsl,imx-audio-hdmi";
		hdmi-controller = <0x39>;
		model = "imx-audio-hdmi";
	};

	clocks {
		#address-cells = <0x01>;
		#size-cells = <0x00>;

		clk24m {
			compatible = "fixed-clock";
			clock-frequency = <0x16e3600>;
			#clock-cells = <0x00>;
		};

		ckih1 {
			compatible = "fsl,imx-ckih1\0fixed-clock";
			clock-frequency = <0x00>;
		};

		ckil {
			compatible = "fsl,imx-ckil\0fixed-clock";
			clock-frequency = <0x8000>;
		};

		osc {
			compatible = "fsl,imx-osc\0fixed-clock";
			clock-frequency = <0x16e3600>;
		};
	};

	ft5x06-reset {
		#reset-cells = <0x00>;
		linux,phandle = <0x2b>;
		compatible = "gpio-reset";
		reset-delay-us = <0x4e20>;
		phandle = <0x2b>;
		reset-gpios = <0x21 0x13 0x01>;
	};

	fb@1 {
		int_clk = <0x00>;
		compatible = "fsl,mxc_sdc_fb";
		disp_dev = "hdmi";
		mode_str = "1920x1080M@60";
		default_bpp = <0x20>;
		interface_pix_fmt = "RGB24";
		late_init = <0x00>;
		status = "okay";
	};

	interrupt-controller@00a01000 {
		linux,phandle = <0x01>;
		compatible = "arm,cortex-a9-gic";
		#interrupt-cells = <0x03>;
		#address-cells = <0x01>;
		#size-cells = <0x01>;
		reg = <0xa01000 0x1000 0xa00100 0x100>;
		phandle = <0x01>;
		interrupt-controller;
	};

	dsa-reset {
		#reset-cells = <0x00>;
		linux,phandle = <0x3b>;
		compatible = "gpio-reset";
		reset-delay-us = <0x2710>;
		phandle = <0x3b>;
		reset-gpios = <0x26 0x09 0x01>;
	};

	v4l2_cap_0 {
		csi_id = <0x00>;
		mipi_camera;
		compatible = "fsl,imx6q-v4l2-capture";
		ipu_id = <0x00>;
		mclk_source = <0x00>;
		status = "okay";
	};

	cpus {
		#address-cells = <0x01>;
		#size-cells = <0x00>;

		cpu@0 {
			soc-supply = <0x33>;
			compatible = "arm,cortex-a9";
			cooling-min-level = <0x00>;
			#cooling-cells = <0x02>;
			clock-latency = <0xee6c>;
			arm-supply = <0x32>;
			cooling-max-level = <0x04>;
			next-level-cache = <0x31>;
			reg = <0x00>;
			device_type = "cpu";
			clocks = <0x02 0x68 0x02 0x06 0x02 0x10 0x02 0x11 0x02 0xaa 0x02 0xee 0x02 0xe7 0x02 0xe0>;
			operating-points = <0x124f80 0x12b128 0xf32a0 0x12b128 0xd0020 0x12b128 0xc15c0 0x118c30 0x60ae0 0xf4240>;
			clock-names = "arm\0pll2_pfd2_396m\0step\0pll1_sw\0pll1_sys\0pll1_bypass\0pll1\0pll1_bypass_src";
			pu-supply = <0x12>;
			fsl,soc-operating-points = <0x124f80 0x124f80 0xf32a0 0x11edd8 0xd0020 0x11edd8 0xc15c0 0x11edd8 0x60ae0 0x11edd8>;
		};

		cpu@2 {
			compatible = "arm,cortex-a9";
			next-level-cache = <0x31>;
			reg = <0x02>;
			device_type = "cpu";
		};

		cpu@1 {
			compatible = "arm,cortex-a9";
			next-level-cache = <0x31>;
			reg = <0x01>;
			device_type = "cpu";
		};

		cpu@3 {
			compatible = "arm,cortex-a9";
			next-level-cache = <0x31>;
			reg = <0x03>;
			device_type = "cpu";
		};
	};

	sound {
		compatible = "fsl,imx6q-sabrelite-dvf9919\0fsl,dvf9919-audio";
		mux-ext-port = <0x04>;
		mux-int-port = <0x02>;
		model = "dvf9919-audio";
		ssi-controller = <0x35>;
		fm-controller = <0x36>;
	};

	ar3002_codec {
		linux,phandle = <0x38>;
		compatible = "fsl,ar3002";
		clocks = <0x02 0xc9>;
		phandle = <0x38>;
	};

	hw_rev {
		max8_hw_det-values = <0x05 0x06 0x04 0x03>;
		max10_hw_det-names = "1 to 2a\02b to 3b\04 to 5\06 to 8\09\010 to 11\012";
		max10_hw_det-values = <0x00 0x01 0x03 0x02 0x06 0x05 0x04>;
		max8_hw_det-names = "PoC to 1\02\03\04";
		hw_brd-values = <0x00 0x80000000>;
		hw_brd-names = "max10\0max8";
		pinctrl-0 = <0x3f>;
		status = "okay";
		pinctrl-names = "default";

		hw_pin0 {
			label = "hw-rev-0";
			value = <0x01>;
			gpio = <0x40 0x0c 0x01>;
		};

		hw_pin2 {
			label = "hw-rev-2";
			value = <0x04>;
			gpio = <0x34 0x15 0x01>;
		};

		hw_pin3 {
			label = "hw-rev-3";
			value = <0x80000000>;
			gpio = <0x34 0x1f 0x01>;
		};

		hw_pin1 {
			label = "hw-rev-1";
			value = <0x02>;
			gpio = <0x34 0x1c 0x01>;
		};
	};

	sound_bt {
		compatible = "fsl,imx6q-sabrelite-ar3002\0fsl,ar3002-audio";
		mux-ext-port = <0x05>;
		mux-int-port = <0x07>;
		model = "ar3002-audio";
		ssi-controller = <0x37>;
		fm-controller = <0x38>;
	};

	ramoops_device {
		compatible = "fsl,mxc_ramoops";
		console_size = <0x40000>;
		ftrace_size = <0x40000>;
		record_size = <0x80000>;
		status = "okay";
		dump_oops = <0x01>;
	};

	memory {
		reg = <0x10000000 0x80000000>;
		device_type = "memory";
	};
};
